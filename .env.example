# Copier ce fichier en .env à la racine du projet et renseigner vos valeurs.
# Ne jamais committer le fichier .env.

# Base de données
DB_HOST=localhost
DB_NAME=pronosocial
DB_USER=root
DB_PASS=

# The Odds API — https://the-odds-api.com
ODDS_API_KEY=

# Affichage — prod v1.0 : APP_BETA=0
APP_BETA=1
APP_CONTACT_EMAIL=contact@prognoz.fr

# E-mails transactionnels (reset mot de passe)
MAIL_FROM=noreply@prognoz.fr
MAIL_FROM_NAME=Prognoz

# SMTP LWS — choisir UNE des deux configs (pas de mélange ssl + 587)
# Option A (recommandée LWS) :
# MAIL_SMTP_HOST=mail73.lwspanel.com
# MAIL_SMTP_PORT=465
# MAIL_SMTP_SECURE=ssl
# Option B :
# MAIL_SMTP_PORT=587
# MAIL_SMTP_SECURE=tls
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=465
MAIL_SMTP_USER=noreply@prognoz.fr
MAIL_SMTP_PASS="votre_mot_de_passe"
MAIL_SMTP_SECURE=ssl
APP_OG_DESCRIPTION=Pariez entre amis sur le foot, le basket et le tennis. Cumulez des points, créez des communautés privées et défiez vos potes — sans bookmaker, 100 % gratuit.

# URL canonique (requis en prod pour Google, Open Graph et sitemap)
APP_URL=https://www.prognoz.fr

# Maintenance (1 = site fermé, page maintenance.php)
APP_MAINTENANCE=0
# Bypass : https://prognoz.fr/?bypass=VOTRE_CLE
MAINTENANCE_BYPASS_KEY=

# Chiffrement RGPD (messages chat + noms/descriptions communautés)
# Générer : php -r "echo base64_encode(random_bytes(32)) . PHP_EOL;"
APP_ENCRYPTION_KEY=

# Cron sync — php -r "echo bin2hex(random_bytes(16)) . PHP_EOL;"
CRON_SECRET=
# IDs autorisés à forcer la sync depuis Paramètres (CSV). Sinon = e-mail APP_CONTACT_EMAIL.
SYNC_ADMIN_USER_IDS=

# Web Push (notifications communauté) — php tools/generate_vapid.php puis composer install
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@prognoz.fr

# Panel admin web (Prognoz Ops) — générer :
#   php tools/generate_admin_credentials.php
# URL : https://votredomaine/admin/?s=ADMIN_PANEL_SLUG
# Compte dédié (hors table users) — ne pas committer le slug ni le hash.
ADMIN_PANEL_SLUG=
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Console admin Python locale (tools/admin_console/) — optionnel
# Code simple ou hash SHA-256 : python -c "import hashlib; print(hashlib.sha256(b'votre_code').hexdigest())"
ADMIN_CONSOLE_PIN=
